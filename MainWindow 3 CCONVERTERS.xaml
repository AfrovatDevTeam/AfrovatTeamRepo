<Window x:Class="Prj_CConverters.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Main Window" Height="450" Width="800">
    <Grid Background="Red">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="600">

            <Button x:Name="BtnUserInput" Content="USERS INPUT WINDOW"
                    Height="80" Margin="0,0,0,20"
                    FontSize="26" FontWeight="Bold"
                    Background="Gold"
                    Click="BtnUsersInput_Click"/>

            <Button x:Name="BtnCurrency" Content="CURRENCY CONVERTER"
                    Height="80"
                    FontSize="26" FontWeight="Bold"
                    Background="Gold"
                    Click="BtnCurrency_Click"/>
        </StackPanel>
    </Grid>
</Window>