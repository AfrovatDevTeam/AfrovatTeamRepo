namespace Prj_Currency_Converter
{
    /// <summary>
    /// Interaction logic for User_Input_Window.xaml
    /// </summary>
    public partial class User_Input_Window : Window
    {
        public User_Input_Window()
        {
            InitializeComponent();
        }

        private void btnadd_Click(object sender, RoutedEventArgs e) =>

            listbox.Items.Add(txtuserinput.Text);

        private void btnremove_Click(object sender, RoutedEventArgs e)
        {
            listbox.Items.RemoveAt((int)listbox.SelectedItem);
        }

        private void btncount_Click(object sender, RoutedEventArgs e)
        {
            MessageBox.Show(this.listbox.Items.Count.ToString(),"Total Current Value");
        }

        private void btnclear_Click(object sender, RoutedEventArgs e)
        {
            listbox.Items.Clear();
        }
    }
}
