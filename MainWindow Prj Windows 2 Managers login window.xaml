<Window x:Class="Prj_Window_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800">

    <Grid Background="Red">
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="600">

            <Button Content="MANAGERS LOGIN WINDOW"
                    Height="80" Margin="0,0,0,20"
                    FontSize="26" FontWeight="Bold"
                    Background="Gold"
                    Click="BtnManagersLogin_Click"/>

            <Button Content="EMPLOYEE LOGIN WINDOW"
                    Height="80" Margin="0,0,0,20"
                    FontSize="26" FontWeight="Bold"
                    Background="Gold"
                    Click="BtnEmployeeLogin_Click"/>

            <Button Content="MANAGERS REGISTRATION WINDOW"
        Height="80" Margin="0,0,0,20"
        FontSize="26" FontWeight="Bold"
        Background="LightBlue"
        Click="BtnManagersReg_Click"/>

            <Button Content="STUDENT REGISTRATION WINDOW"
        Height="80"
        FontSize="26" FontWeight="Bold"
        Background="Gold"
        Click="BtnStudentReg_Click"/>

        </StackPanel>
    </Grid>
</Window>
