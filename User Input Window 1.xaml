<Window x:Class="Prj_Currency_Converter.User_Input_Window"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prj_Currency_Converter"
        mc:Ignorable="d"
        Title="User_Input_Window" Height="450" Width="800">


    <Grid x:Name="Userinputwindow" Background="#FFFF2583">
        <ListBox x:Name="listbox" HorizontalAlignment="Left" Height="351" Margin="10,40,0,0" VerticalAlignment="Top" Width="390" d:ItemsSource="{d:SampleData ItemCount=5}"/>
        <TextBox x:Name="txtuserinput" HorizontalAlignment="Left" Height="61" Margin="518,10,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="251"/>
        <Button x:Name="btnadd" Content="Add" HorizontalAlignment="Left" Height="50" Margin="459,101,0,0" VerticalAlignment="Top" Width="239" FontFamily="Algerian" FontSize="25" Background="#FF1CE9AE" Click="btnadd_Click"/>
        <Button x:Name="btnremove" Content="Remove" HorizontalAlignment="Left" Height="50" Margin="459,0,0,0" VerticalAlignment="Center" Width="239" RenderTransformOrigin="0.52,0.317" FontFamily="Algerian" FontSize="25" Background="#FF12D49C" Click="btnremove_Click"/>
        <Button x:Name="btncount" Content="Count" HorizontalAlignment="Left" Height="50" Margin="459,272,0,0" VerticalAlignment="Top" Width="239" FontFamily="Algerian" FontSize="25" Background="#FF1ED9A3" Click="btncount_Click"/>
        <Button x:Name="btnclear" Content="Clear" HorizontalAlignment="Left" Height="50" Margin="459,356,0,0" VerticalAlignment="Top" Width="239" FontFamily="Algerian" FontSize="25" Background="#FF1ED7A2" Click="btnclear_Click"/>

    </Grid>
</Window>
