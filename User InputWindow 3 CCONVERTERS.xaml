<Window x:Class="Prj_CConverters.UserInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Input Window" Height="350" Width="650">
    <Grid Margin="15" Background="#FFC81616">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- Textbox -->
        <TextBox x:Name="txtInput" Grid.Column="0" Grid.Row="0"
                 Height="35" FontSize="16" Margin="278,0,103,10" Grid.ColumnSpan="2"/>

        <!-- Listbox -->
        <ListBox x:Name="lstItems" Grid.Column="0" Grid.Row="1"
                 Margin="0,0,103,10" FontSize="16"/>

        <!-- Buttons -->
        <StackPanel Grid.Column="1" Grid.Row="1" VerticalAlignment="Top">
            <Button x:Name="BtnAdd" Content="Add" Height="35" Margin="0,0,0,10" Click="BtnAdd_Click" Background="#FFF0EB12"/>
            <Button x:Name="BtnRemove" Content="Remove" Height="35" Margin="0,0,0,10" Click="BtnRemove_Click" Background="#FFEDE715"/>
            <Button x:Name="BtnCount" Content="Count" Height="35" Margin="0,0,0,10" Click="BtnCount_Click" Background="#FFE9E515"/>
            <Button x:Name="BtnClear" Content="Clear" Height="35" Click="BtnClear_Click" Background="#FFEBE612"/>
        </StackPanel>
    </Grid>
</Window>