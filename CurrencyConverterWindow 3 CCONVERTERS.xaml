<Window x:Class="Prj_Currency_Converter.Currency_Converter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Currency Converter" Height="500" Width="900">
    <Grid Margin="15" Background="#FF11D13F">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Button x:Name="currencyconverter"
                Grid.Row="0"
                Height="40"
                FontSize="25"
                Content="Link to Online Currency Converter"
                Click="currencyconverter_Click" FontFamily="Algerian" Background="#FF728973"/>

        <WebBrowser x:Name="btnwebbrowser"
                    Grid.Row="1"
                    Margin="70,65,67,54"/>
    </Grid>
</Window>
